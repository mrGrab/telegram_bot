# Copy to .env and fill in real values. Never commit .env.
BOT_TOKEN=<telegram-bot-token>
TELEGRAM_WEBHOOK_SECRET=<random-string-A-Za-z0-9_->
# JSON list; notifications may contain "dtek"
TELEGRAM_CHATS=[{"id":123456789,"notifications":["dtek"]}]

# Home Assistant electricity check (all required)
HASS_URL=https://homeassistant.example.com
HASS_TOKEN=<home-assistant-long-lived-token>
HASS_POWER_ENTITY_ID=binary_sensor.example_power_present

# Optional (defaults shown)
HOST=127.0.0.1
PORT=80
DEBUG=false
ALEXA_HOST=127.0.0.1
ALEXA_PORT=80
DTEK_CITY=Київ
DTEK_STREET=Хрещатик
DTEK_BUILDING=1
DTEK_STATE_FILE=last_state.json
